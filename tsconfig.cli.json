{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-cli",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "cli/index.ts",
    "cli/mirror.ts",
    "src/core.ts",
    "src/kitchen/doc.ts",
    "src/kitchen/merge.ts"
  ]
}
