#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
refs_file="$(mktemp)"
trap 'rm -f "${refs_file}"' EXIT
tee "${refs_file}" >/dev/null

if [[ -x "${repo_root}/.beads/hooks/pre-push" ]]; then
  "${repo_root}/.beads/hooks/pre-push" "$@" <"${refs_file}"
fi

"${repo_root}/scripts/pre-push.sh" --pre-push <"${refs_file}"
