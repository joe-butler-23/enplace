# Static application security headers
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; manifest-src data:; connect-src 'self' __ENPLACE_RELAY_ORIGIN__; form-action 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Hashed build assets never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned deliberately; these paths otherwise remain stable.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/enplace-mark.png
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

# Build-time navigation Cache-Control and Link headers are appended to dist-static/_headers by Vite.
