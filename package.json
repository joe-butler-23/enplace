{
  "name": "enplace",
  "version": "0.1.0",
  "description": "Enplace — local-first cooking app.",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode static",
    "build:static": "vite build --mode static",
    "build:cli": "tsc -p tsconfig.cli.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "relay": "node scripts/kitchen-relay.mjs",
    "lint:provider-residue": "./scripts/lint-provider-residue.sh",
    "precommit": "./scripts/pre-commit.sh",
    "prepush": "./scripts/pre-push.sh",
    "setup:hooks": "./scripts/install-git-hooks.sh",
    "preflight:release": "./scripts/preflight-release.sh",
    "test:static-pwa": "playwright test --config=playwright.static-pwa.config.ts",
    "test:kanban-client": "playwright test --config=playwright.kanban-client.config.ts",
    "test:kanban-provenance": "node --test scripts/kanban-provenance-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:startup": "vitest run src/standalone/storage.test.ts",
    "test:watch": "vitest watch",
    "prepack": "npm run build:cli",
    "test:latency-derivation": "node --test scripts/benchmark-perceived-latency.node-test.mjs",
    "benchmark:latency": "node scripts/benchmark-perceived-latency.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdxeditor/editor": "^4.2.3",
    "dragula": "^3.7.3",
    "fflate": "^0.8.3",
    "pikaday": "^1.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/dragula": "^3.7.5",
    "@types/node": "^25.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.12",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "ws": "^8.21.3"
  },
  "bin": {
    "mep": "dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli"
  ]
}
