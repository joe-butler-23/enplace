{
  "name": "enplace",
  "version": "0.1.0",
  "private": true,
  "description": "Enplace \u2014 self-hosted cooking app (web + PWA).",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:kanban-core": "vite build --config vite.kanban-core.config.ts",
    "build:kanban-client": "vite build --config vite.kanban-core.config.ts --mode kanban-client",
    "build:remote-helper": "cargo build --release -p mep-remote-host-helper",
    "host:web": "npm run build && node ./scripts/start-web-host.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint:provider-residue": "./scripts/lint-provider-residue.sh",
    "precommit": "./scripts/pre-commit.sh",
    "prepush": "./scripts/pre-push.sh",
    "preflight:release": "./scripts/preflight-release.sh",
    "benchmark:recipe-scroll": "node scripts/benchmark-recipe-scroll.mjs",
    "perf:report": "node scripts/report-web-bundle.mjs",
    "perf:budget": "node scripts/check-release-budgets.mjs",
    "perf:release": "node scripts/release-evidence.mjs",
    "test:release-evidence": "node --test scripts/release-evidence-check.mjs",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:diagnostics": "playwright test --config=playwright.diagnostics.config.ts",
    "test:kanban-client": "playwright test --config=playwright.kanban-client.config.ts",
    "test:kanban-provenance": "node --test scripts/kanban-provenance-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:startup": "vitest run src/standalone/storage.test.ts",
    "test:watch": "vitest watch",
    "test:smoke": "playwright test",
    "test:benchmark-database-latency": "node --test scripts/benchmark-database-latency.node-test.mjs",
    "benchmark:database-latency": "node scripts/benchmark-database-latency.mjs",
    "perf:planner-transition": "node scripts/benchmark-planner-transition.mjs"
  },
  "keywords": [
    "cooking",
    "recipes",
    "kanban"
  ],
  "license": "MIT",
  "dependencies": {
    "@mdxeditor/editor": "^4.0.4",
    "dragula": "^3.7.3",
    "moment": "^2.30.1",
    "pikaday": "^1.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/dragula": "^3.7.5",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "simple-update-notifier": {
      "semver": "7.6.3"
    }
  }
}
