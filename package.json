{
  "name": "enplace",
  "version": "0.1.0",
  "description": "Enplace — local-first cooking app.",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sample-pack && vite build --mode static",
    "build:static": "npm run build:sample-pack && vite build --mode static",
    "build:cli": "rm -rf dist-cli && tsc -p tsconfig.cli.json",
    "build:release": "npm run build:static && npm run build:cli && npm run build --workspace=enplace-relay",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "relay": "node scripts/cookbook-relay.mjs",
    "lint:provider-residue": "./scripts/lint-provider-residue.sh",
    "precommit": "./scripts/pre-commit.sh",
    "prepush": "./scripts/pre-push.sh",
    "setup:hooks": "./scripts/install-git-hooks.sh",
    "preflight:release": "./scripts/preflight-release.sh",
    "test:static-pwa": "playwright test --config=playwright.static-pwa.config.ts",
    "check:playwright-runtime": "node scripts/check-playwright-runtime.mjs",
    "test:pages-boundary": "node scripts/check-pages-boundary.mjs",
    "typecheck:app": "tsc --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck --workspace=enplace-relay",
    "test": "vitest run",
    "test:cli-package": "node scripts/verify-cli-package.mjs",
    "test:coverage": "vitest run --coverage",
    "test:startup": "vitest run src/standalone/storage.test.ts",
    "test:watch": "vitest watch",
    "prepack": "npm run build:cli",
    "build:sample-covers": "node scripts/build-sample-covers.mjs",
    "build:sample-pack": "node scripts/build-sample-pack.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^25.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "dompurify": "^3.4.14",
    "fflate": "^0.8.3",
    "happy-dom": "^20.11.12",
    "lib0": "^0.2.117",
    "pikaday": "^1.8.2",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "qrcode": "^1.5.4",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "wrangler": "4.128.0",
    "ws": "^8.21.3",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "bin": {
    "mep": "dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli"
  ],
  "workspaces": [
    "relay"
  ]
}
