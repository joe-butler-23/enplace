{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "enplace-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "Kitchen", "class_name": "Kitchen" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kitchen"] }],
  "ratelimits": [
    {
      "name": "NEW_ROOM_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
